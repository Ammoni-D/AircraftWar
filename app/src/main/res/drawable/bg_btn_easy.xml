<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#5A73E8"
                android:endColor="#7A8BFF"
                android:angle="45"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#B0B8FF"/>
            <padding android:padding="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#7A8BFF"
                android:endColor="#5A73E8"
                android:angle="45"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#D0D8FF"/>
            <padding android:padding="12dp"/>
        </shape>
    </item>
</selector>